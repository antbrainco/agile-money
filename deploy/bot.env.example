# Copy to bot.env on the server and chmod 600. Read by docker compose only.
# Neon: the direct endpoint (no "-pooler" in the host). The bot sets statement_timeout
# as a startup option and migrations take an advisory lock; PgBouncer allows neither.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/warden?sslmode=require
TELOXIDE_TOKEN=
WARDEN_TELEGRAM__OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
WARDEN_AGENT__API_KEY=
# The wallet key from env: fine for devnet. With real funds, keep it in a KMS or HSM.
WARDEN_RAIL__SOL__KEYPAIR=
