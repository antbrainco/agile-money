# Copy to .env. Secrets come from the environment or KMS, never warden.toml.
DATABASE_URL=postgres://warden:warden@localhost:5433/warden
WARDEN_NETWORK=devnet
RUST_LOG=info,warden=debug
TELOXIDE_TOKEN=
WARDEN_TELEGRAM__OWNER_CHAT_ID=
# Webhook mode: the tunnel's public URL (overrides telegram.webhook.url) and a stable
# secret, e.g. from `openssl rand -hex 32`.
# TUNNEL_URL=https://bot.example.com
TELEGRAM_WEBHOOK_SECRET=
DEEPSEEK_API_KEY=
# Or OPENAI_API_KEY / ANTHROPIC_API_KEY for those providers, or WARDEN_AGENT__API_KEY for any.
# Authenticated Cloudflare AI Gateway only:
# WARDEN_AGENT__GATEWAY__TOKEN=
# Devnet only: base58 secret key or the JSON array from `solana-keygen new -o key.json`.
WARDEN_RAIL__SOL__KEYPAIR=

# Optional: PayPal requests in USD (sandbox REST app at developer.paypal.com)
# WARDEN_RAIL__PAYPAL__CLIENT_ID=
# WARDEN_RAIL__PAYPAL__CLIENT_SECRET=

# Dashboard API (apps/dashboard), on 127.0.0.1:8787 when set. 32+ chars: openssl rand -hex 32
DASHBOARD_TOKEN=
