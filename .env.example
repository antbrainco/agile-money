# Copy to .env. Secrets come from the environment or KMS, never agile-money.toml.
DATABASE_URL=postgres://agile_money:agile_money@localhost:5433/agile_money
AGILE_MONEY_NETWORK=devnet
RUST_LOG=info,agile_money=debug
TELOXIDE_TOKEN=
AGILE_MONEY_TELEGRAM__OWNER_CHAT_ID=
# Webhook mode: the tunnel's public URL (overrides telegram.webhook.url) and a stable
# secret, e.g. from `openssl rand -hex 32`.
# TUNNEL_URL=https://bot.example.com
TELEGRAM_WEBHOOK_SECRET=
DEEPSEEK_API_KEY=
# Or OPENAI_API_KEY / ANTHROPIC_API_KEY for those providers, or AGILE_MONEY_AGENT__API_KEY for any.
# Authenticated Cloudflare AI Gateway only:
# AGILE_MONEY_AGENT__GATEWAY__TOKEN=
# Devnet only: base58 secret key or the JSON array from `solana-keygen new -o key.json`.
AGILE_MONEY_RAIL__SOL__KEYPAIR=

# Optional: PayPal requests in USD (sandbox REST app at developer.paypal.com)
# AGILE_MONEY_RAIL__PAYPAL__CLIENT_ID=
# AGILE_MONEY_RAIL__PAYPAL__CLIENT_SECRET=

# Dashboard API (apps/dashboard), on 127.0.0.1:8787 when set. 32+ chars: openssl rand -hex 32
DASHBOARD_TOKEN=

# Authenticator codes for anything that loosens what Agile Money may pay: new or changed
# contacts, higher limits, resuming after /pause. Run, in your own terminal:
#   cargo run -p agile-money-telegram-bot --example totp_setup
# It fills this in after you scan the QR code. Without it, contacts come from agile-money.toml only.
# TOTP_SECRET=
